{
    "name": "bestproject/basetheme",
    "description": "Wordpress base theme build on Bootstrap 5",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Artur Stępień",
            "email": "artur.stepien@bestproject.pl"
        }
    ],
    "autoload": {
        "psr-4": {
            "":"src/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "3.x",
        "phpcompatibility/php-compatibility": "9.x",
        "dealerdirect/phpcodesniffer-composer-installer": "1.x"
    },
    "require": {
        "php": ">=8.4"
    },
    "scripts": {
        "post-autoload-dump": [
            "@build"
        ],
        "build": [
            "BestProject\\Command\\Build::execute"
        ],
        "make": [
            "BestProject\\Command\\Make::execute"
        ],
        "test:compatibility": [
            "@test:compatibility:php"
        ],
        "test:compatibility:php": "phpcs --standard=.phpcs/compatibility/php.xml ."
    },
    "scripts-descriptions": {
        "build": "Build theme."
    }
}
